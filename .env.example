# Neon Postgres connection string (required).
# Copy from Neon dashboard → Connection Details → "Pooled" or "Direct" connection string.
DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require

# JWT signing secret (required). Use 32+ random characters.
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Vercel Blob token (auto-injected on Vercel — set locally only for `vercel dev`).
# Create from: Vercel dashboard → Storage → Blob → connect to project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# Optional. Set NODE_ENV=production locally if you want Secure cookies.
# NODE_ENV=development
